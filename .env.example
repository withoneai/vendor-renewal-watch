# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent list` (the `key` field for each platform)
ONE_CONNECTION_QUICKBOOKS=
ONE_CONNECTION_NOTION=

# Your QuickBooks Online company ID (the realmId in your QuickBooks URL,
# e.g. qbo.intuit.com/app/homepage?...realmId=9130...)
QUICKBOOKS_REALM_ID=

# The Notion data source that holds your tool inventory. Open the database,
# copy its link, and use the data source id (see README, "The tool inventory").
NOTION_INVENTORY_DATA_SOURCE_ID=

# Optional: post the renewal brief to a Slack channel. Both lines or neither.
# ONE_CONNECTION_SLACK=
# SLACK_CHANNEL=#finance

# Optional: how far back to read spend (default 24 months, so annual
# contracts show at least two charges)
# LOOKBACK_MONTHS=24

# Optional: only ask the model about renewals whose decision date falls in
# the next N days (default 90). Everything further out is listed, not judged.
# WATCH_DAYS=90

# Optional: override the Claude model (default claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
